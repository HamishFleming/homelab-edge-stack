# Choose a private domain you control; home.arpa is also suitable.
LOCAL_DOMAIN=mylocal.server
# Docker host's static LAN IPv4 address (never 127.0.0.1).
HOST_IP=192.168.1.10
ACME_EMAIL=admin@mylocal.server
TZ=Australia/Melbourne
# Must not overlap your LAN, VPN, or other Docker networks.
PROXY_SUBNET=172.30.0.0/24
DNS_IP=172.30.0.53
PROXY_NETWORK=local-proxy
# Version channels; set these to immutable versions/digests for controlled updates.
TRAEFIK_IMAGE=traefik:v3
PORTAINER_IMAGE=portainer/portainer-ce:lts
STEP_CA_IMAGE=smallstep/step-ca:latest
TECHNITIUM_IMAGE=technitium/dns-server:latest
PYTHON_IMAGE=python:3.13-alpine
